PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Docker Code Execution Engine Settings
CODE_EXEC_TIMEOUT_MS=5000
CODE_EXEC_MEMORY_LIMIT=256m
CODE_EXEC_CPU_LIMIT=1.0
CODE_EXEC_PIDS_LIMIT=64
CODE_EXEC_MAX_OUTPUT_BYTES=1048576
CODE_EXEC_MAX_CODE_SIZE=102400
CODE_EXEC_MAX_STDIN_SIZE=102400
CODE_EXEC_MAX_CONCURRENT=5
DOCKER_CMD=docker
DOCKER_NETWORK=none
DOCKER_READONLY_FS=true

# Execution Runtime Images
DOCKER_IMAGE_PYTHON=python:3.12-slim
DOCKER_IMAGE_JAVA=openjdk:21-slim
DOCKER_IMAGE_CPP=gcc:13-bookworm
DOCKER_IMAGE_NODE=node:20-slim
